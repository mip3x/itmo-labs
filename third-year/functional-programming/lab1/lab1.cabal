cabal-version: 3.0
name: lab1
version: 0.1.0.0
build-type: Simple

library
    exposed-modules:
        Problem2
        Problem19
    hs-source-dirs: src
    build-depends: base >= 4.18 && < 5
    default-language: Haskell2010
    ghc-options: -Wall -Werror

executable lab1
    main-is: Main.hs
    hs-source-dirs: app
    build-depends:
        base >= 4.18 && < 5,
        lab1
    default-language: Haskell2010
    ghc-options: -Wall -Werror

test-suite lab1-tests
    type: exitcode-stdio-1.0
    main-is: Main.hs
    hs-source-dirs: test
    build-depends:
        base >= 4.18 && < 5,
        lab1
    default-language: Haskell2010
    ghc-options: -Wall -Werror
